# Terminal productivity
brew "lazygit"      # interactive git TUI
brew "git-delta"    # syntax-highlighted git diff pager
brew "dust"         # better du, tree-style disk usage
brew "glow"         # render markdown in terminal
brew "tealdeer"     # fast Rust client for `tldr` cheatsheets

# Terminal emulator
cask "ghostty"

# Font with Nerd Font glyphs (for Starship / nvim icons)
cask "font-jetbrains-mono-nerd-font"
