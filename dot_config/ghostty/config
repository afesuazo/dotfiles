# Ghostty config - identical on macOS and Linux.
# Docs: https://ghostty.org/docs/config

font-family = JetBrainsMono Nerd Font
font-size = 14

theme = dawnfox
cursor-style = bar
cursor-style-blink = false

window-padding-x = 8
window-padding-y = 8
window-save-state = always

copy-on-select = clipboard
mouse-hide-while-typing = true

# Scrollback: match tmux's history-limit (200000 lines).
scrollback-limit = 200000

# Quiet life.
confirm-close-surface = false
